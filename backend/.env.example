# RVCE Student Intelligence OS - Environment Configuration Template
# Copy this file to .env and fill in your values

PORT=5000

# MongoDB URI: Either local mongod instance or MongoDB Atlas Cloud cluster
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/rvce_student_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/rvce_student_db

# Environment Mode: development / production
NODE_ENV=development
